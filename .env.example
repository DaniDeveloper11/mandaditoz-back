HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Email (Resend — https://resend.com)
# API key con permisos de "Sending access" (empieza con re_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Dirección remitente. Debe pertenecer a un dominio verificado en Resend.
# Para pruebas iniciales puedes usar "onboarding@resend.dev" (solo llega a tu propio email).
EMAIL_FROM=noreply@mandaditoz.com
EMAIL_REPLY_TO=hola@mandaditoz.com

# Notificaciones de solicitudes de publicación
# Email que recibe las notificaciones de nuevas solicitudes en /businesses/submit.
# Si se omite, no se manda email al admin (solo al submitter).
ADMIN_NOTIFICATION_EMAIL=admin@mandaditoz.com

# URLs usadas en los emails
# Del backend (usado por Strapi para construir el link de confirmación de cuenta:
# ${PUBLIC_URL}/api/auth/email-confirmation?confirmation=...). En producción DEBE ser https.
PUBLIC_URL=http://localhost:1337
# Del panel de Strapi (para el link "Revisar en el panel").
PUBLIC_ADMIN_URL=http://localhost:1337/admin
# Del frontend. Usado para:
#  - link "Ver la ficha del negocio" al submitter tras publicación.
#  - redirect tras confirmar email (${FRONTEND_URL}/cuenta/confirmada).
#  - link del email de reset de password (${FRONTEND_URL}/cuenta/reset-password).
FRONTEND_URL=http://localhost:3000
