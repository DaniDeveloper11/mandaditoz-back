{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "Metadatos para buscadores y redes sociales"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "keywords": {
      "type": "string",
      "maxLength": 200
    },
    "canonicalUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+$"
    }
  }
}
