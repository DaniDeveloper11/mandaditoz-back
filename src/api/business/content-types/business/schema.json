{
  "kind": "collectionType",
  "collectionName": "businesses",
  "info": {
    "singularName": "business",
    "pluralName": "businesses",
    "displayName": "Business",
    "description": "Negocios del directorio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "richtext",
      "maxLength": 3000
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "businesses"
    },
    "secondaryCategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "secondaryBusinesses"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "businesses"
    },
    "phones": {
      "type": "component",
      "repeatable": true,
      "component": "business.phone"
    },
    "email": {
      "type": "email"
    },
    "submitterName": {
      "type": "string",
      "maxLength": 120,
      "private": true
    },
    "submitterEmail": {
      "type": "email",
      "private": true
    },
    "submitterPhone": {
      "type": "string",
      "maxLength": 20,
      "private": true
    },
    "termsAcceptedAt": {
      "type": "datetime",
      "private": true,
      "description": "Fecha/hora en que el submitter aceptó los Términos y la Política de privacidad. Solo se setea desde el flujo público /businesses/submit."
    },
    "website": {
      "type": "string",
      "regex": "^https?:\\/\\/[^\\s]+\\.[^\\s]+$"
    },
    "address": {
      "type": "component",
      "repeatable": false,
      "component": "shared.address"
    },
    "geo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.geo"
    },
    "mapEmbedUrl": {
      "type": "text",
      "description": "URL de embed de Google Maps (iframe src)"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "businesses"
    },
    "neighborhood": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::neighborhood.neighborhood",
      "inversedBy": "businesses"
    },
    "businessStatus": {
      "type": "enumeration",
      "enum": ["draft", "published", "pending_review", "suspended"],
      "default": "draft",
      "required": true
    },
    "ownershipStatus": {
      "type": "enumeration",
      "enum": ["unclaimed", "pending_claim", "claimed"],
      "default": "unclaimed",
      "required": true
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "ownedBusinesses"
    },
    "createdByAdmin": {
      "type": "boolean",
      "default": false
    },
    "isMobile": {
      "type": "boolean",
      "default": false,
      "description": "Negocio ambulante o sin ubicación fija"
    },
    "visibleInAllCities": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, el negocio aparece en las búsquedas de cualquier municipio, no solo en su city base."
    },
    "isVerified": {
      "type": "boolean",
      "default": false
    },
    "verifiedAt": {
      "type": "datetime"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "featuredUntil": {
      "type": "datetime"
    },
    "featuredOrder": {
      "type": "integer",
      "min": 1,
      "description": "Posicion manual en los carruseles de destacados: 1 = primero. Vacio = se ordena por rating al final de los numerados"
    },
    "priceLevel": {
      "type": "enumeration",
      "enum": ["free", "budget", "moderate", "upscale", "luxury"],
      "description": "Rango de precios: free (sin costo), budget ($), moderate ($$), upscale ($$$), luxury ($$$$)"
    },
    "paymentMethods": {
      "type": "json",
      "description": "Array de strings: cash, card, transfer, mercado_pago, oxxo, etc."
    },
    "amenities": {
      "type": "json",
      "description": "Array de strings: wifi, parking, wheelchair_access, pet_friendly, delivery, takeout, dine_in, outdoor_seating, reservations, etc."
    },
    "menuUrl": {
      "type": "text"
    },
    "menuPdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "menuImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "menuSections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-section.menu-section",
      "mappedBy": "business"
    },
    "menuItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-item.menu-item",
      "mappedBy": "business"
    },
    "videoUrl": {
      "type": "text"
    },
    "hoursText": {
      "type": "text",
      "maxLength": 500,
      "description": "Descripción libre del horario (fallback para renderizar cuando business-hours no es suficiente)"
    },
    "viewCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "ratingAverage": {
      "type": "decimal",
      "default": 0,
      "min": 0,
      "max": 5
    },
    "ratingCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "reviewCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "logoUrl": {
      "type": "text",
      "description": "URL externa del logo (usado durante seed cuando no hay upload aún)"
    },
    "coverPhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "coverPhotoUrl": {
      "type": "text",
      "description": "URL externa del cover (usado durante seed cuando no hay upload aún)"
    },
    "hours": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::business-hour.business-hour",
      "mappedBy": "business"
    },
    "hourExceptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::business-hour-exception.business-hour-exception",
      "mappedBy": "business"
    },
    "photos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::photo.photo",
      "mappedBy": "business"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "business"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "business.social-link"
    },
    "claims": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::claim.claim",
      "mappedBy": "business"
    },
    "archivedAt": {
      "type": "datetime",
      "description": "Soft delete: si no es null, el negocio está archivado"
    },
    "outreachToken": {
      "type": "string",
      "maxLength": 64,
      "private": true,
      "description": "Token de invitación para reclamar el negocio. PRIVATE obligatorio: si sale por la API pública, cualquiera puede reclamar cualquier ficha."
    },
    "outreachTokenExpiresAt": {
      "type": "datetime",
      "private": true,
      "description": "Vencimiento del outreachToken"
    },
    "outreachPhone": {
      "type": "string",
      "maxLength": 20,
      "private": true,
      "description": "Teléfono al que se envió la invitación, normalizado a 52XXXXXXXXXX"
    },
    "lastOutreachAt": {
      "type": "datetime",
      "private": true,
      "description": "Última vez que se le mandó invitación a este negocio"
    },
    "outreachCount": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "private": true,
      "description": "Cuántas invitaciones se le han mandado"
    },
    "outreachOptOut": {
      "type": "boolean",
      "default": false,
      "private": true,
      "description": "Si es true, no se le vuelve a mandar invitación"
    }
  }
}
